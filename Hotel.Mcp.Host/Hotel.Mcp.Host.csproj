    <ProjectReference Include="..\Hotel.Application\Hotel.Application.csproj" />
    <ProjectReference Include="..\Hotel.Sql\Hotel.Sql.csproj" />
    <Content Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Ui/dist/reservations.html" />
    <EmbeddedResource Include="Ui/dist/preview.html" />
  </ItemGroup>
</Project>
