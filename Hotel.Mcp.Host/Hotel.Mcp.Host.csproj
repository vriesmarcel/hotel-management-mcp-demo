    <NoWarn>$(NoWarn);MCPEXP003</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Demo\ReferenceResources.cs" Link="ReferenceResources.cs" />
